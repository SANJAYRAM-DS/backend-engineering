# ==============================================================================
# Enterprise Environment Configuration Blueprint (.env.example)
# Copy this file to .env and replace placeholder values with secure credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Application Settings
# ------------------------------------------------------------------------------
# DJANGO_ENV: Defines the running environment (development, staging, production)
DJANGO_ENV=development

# DEBUG: Set to True for development (enables detailed stack traces). MUST be False in production!
DEBUG=True

# SECRET_KEY: Cryptographic signing key for Django. Must be a minimum 50-character random string in production.
SECRET_KEY=django-insecure-change-me-in-production-random-50-character-string-1234567890

# ALLOWED_HOSTS: Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=auth_system_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=secure_postgres_password_change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# JWT (JSON Web Token) Security Settings
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Used specifically to sign and verify JWT signatures. Can be separate from DJANGO_SECRET_KEY.
JWT_SECRET_KEY=jwt-secret-key-change-me-in-production-super-secret-random-string

# JWT_ALGORITHM: Cryptographic signing algorithm (HS256 for symmetric, RS256 for asymmetric public/private pair)
JWT_ALGORITHM=HS256

# JWT_ACCESS_TOKEN_LIFETIME_MINUTES: Short-lived access token expiry (Industry Standard: 15 minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# JWT_REFRESH_TOKEN_LIFETIME_DAYS: Long-lived refresh token expiry (Industry Standard: 7 days)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Cookie Security Settings (For Web Clients & Dual-Token Architecture)
# ------------------------------------------------------------------------------
# JWT_COOKIE_SECURE: Set to True in production to ensure cookies are sent ONLY over HTTPS.
JWT_COOKIE_SECURE=False

# JWT_COOKIE_HTTPONLY: Set to True to prevent JavaScript (document.cookie) from accessing the token (mitigates XSS).
JWT_COOKIE_HTTPONLY=True

# JWT_COOKIE_SAMESITE: Strict or Lax to protect against Cross-Site Request Forgery (CSRF).
JWT_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# Security & Rate Limiting Thresholds
# ------------------------------------------------------------------------------
# MAX_LOGIN_ATTEMPTS: Maximum failed consecutive login attempts allowed before locking the account.
MAX_LOGIN_ATTEMPTS=5

# ACCOUNT_LOCKOUT_DURATION_MINUTES: Minutes an account remains locked after reaching max attempts.
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# RATE_LIMIT_REQUESTS_PER_MINUTE: Global API rate limit per IP address per minute.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Settings
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Comma-separated trusted origins permitted to make cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# SMTP / Email Configuration (For Verification & Password Reset)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@authsystem.local
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=Enterprise Auth System <noreply@authsystem.local>
