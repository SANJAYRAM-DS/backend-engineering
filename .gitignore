# ==============================================================================
# Python / Django Enterprise .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Django noise
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Flask / FastAPI / Celery noise
celerybeat-schedule
celerybeat.pid

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# IDE & Editor files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
.dockerignore
